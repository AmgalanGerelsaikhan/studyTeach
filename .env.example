# Database
DATABASE_URL=postgresql://studyteach:dev@localhost:5433/studyteach

# Redis
REDIS_URL=redis://localhost:6379

# Session / CSRF (generate 64 / 32 byte hex)
SESSION_SECRET=replace-me-64-byte-hex
CSRF_SECRET=replace-me-32-byte-hex

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# QPay (sandbox)
QPAY_SANDBOX_MERCHANT_ID=
QPAY_SANDBOX_SECRET=

# E-Barimt (sandbox)
EBARIMT_SANDBOX_URL=https://sandbox.ebarimt.mn
EBARIMT_API_KEY=

# LLM vendor (ADR-0011: GPT-4-class via OpenAI)
LLM_VENDOR=mock
OPENAI_API_KEY=

# SMS aggregator (sandbox)
SMS_AGGREGATOR_URL=
SMS_AGGREGATOR_KEY=

# Ticket signing (ADR-0014: GCP Cloud KMS in prod; software key in dev)
TICKET_SIGNING_MODE=dev
TICKET_SIGNING_DEV_KEY_PATH=./apps/api/test/fixtures/signing/dev-key.pem
GCP_KMS_KEY_NAME=

# Cloudflare Stream — Teacher Academy lesson video (E-025).
# All four are server-only and OPTIONAL. Leave blank in dev: the lesson player
# degrades to the transcript and /teacher-academy/lessons/:id/playback returns
# 503. Set all four to enable signed Cloudflare Stream playback.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
