{
  "name": "@studyteach/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/api-typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:unit": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:revert": "tsx scripts/migrate.ts down",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations",
    "db:seed": "tsx src/db/seed/index.ts",
    "ingest:curriculum": "tsx src/db/seed/curriculum/ingest.ts",
    "ingest:practice": "tsx src/db/seed/curriculum/ingest-practice.ts",
    "ingest:egsh": "tsx src/db/seed/egsh/ingest.ts",
    "ingest:olympiads": "tsx src/db/seed/olympiads/ingest.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@studyteach/contracts": "workspace:*",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "node-pg-migrate": "^7.5.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  }
}
